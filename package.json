{
  "name": "next-github-search",
  "private": true,
  "version": "1.0.0",
  "description": "GitHub Search SPA with Next.js 15, TypeScript, TanStack Query, and secure API proxy.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
